# ============================================================
# Scout Mail — Environment Configuration
# Copy this file to `.env` and fill in real values.
# Never commit `.env` with real secrets.
# ============================================================

# --- Application ---
APP_NAME=scout-mail
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (PRD §7: PostgreSQL via Supabase free tier) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/scout_mail
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# --- Vector store (PRD §7: ChromaDB, local embedded mode) ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_RESUMES=resumes
CHROMA_COLLECTION_JOBS=job_descriptions

# --- LLM inference (PRD §6a.3: task-specialized local models via Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_EXTRACTION=phi3:mini
LLM_MODEL_GENERATION=llama3.1:8b
LLM_MODEL_VALIDATION=mistral:7b
LLM_REQUEST_TIMEOUT_SECONDS=120

# --- Contact Finder / email verification (PRD §6.3, §6a.1) ---
HUNTER_IO_API_KEY=
HUNTER_IO_MONTHLY_QUOTA=25
SMTP_HANDSHAKE_TIMEOUT_SECONDS=10

# --- Job discovery connectors (PRD §6a.2 — comma-separated lists) ---
JOB_SCOUT_POLL_INTERVAL_HOURS=6
GREENHOUSE_BOARD_TOKENS=
LEVER_COMPANY_SLUGS=
ASHBY_ORG_SLUGS=
RSS_FEED_URLS=

# --- Outbound email sending (PRD §8.8 — user's own SMTP/Gmail API credentials) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAX_SENDS_PER_RUN=1

# --- Resume match thresholds (PRD §8.4) ---
RESUME_MATCH_MIN_SCORE=0.55

# --- File storage ---
RESUME_UPLOAD_DIR=./data/resumes